{
  "env": {
    "commonjs": true,
    "node": true,
    "es2021": true
  },
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "plugins": ["json"],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "overrides": [
    {
      "files": ["**/*.json"],
      "rules": {
        "json/*": [
          "error",
          {
            "allowComments": false
          }
        ]
      }
    }
  ],
  "rules": {
    "prettier/prettier": [
      "error",
      {
        "singleQuote": true,
        "semi": true
      }
    ],
    "no-unused-vars": "warn",
    "no-console": "off"
  }
}
